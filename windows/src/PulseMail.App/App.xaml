<Application
    x:Class="PulseMail.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PulseMail.App.Converters">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Tokens from frontend/src/styles/global.css -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PulseBgSidebar" Color="#F4F6FB"/>
          <SolidColorBrush x:Key="PulseBgMailList" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="PulseBgContent" Color="#F7F8FC"/>
          <SolidColorBrush x:Key="PulseBgToolbar" Color="#CCFFFFFF"/>
          <SolidColorBrush x:Key="PulseBgElevated" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="PulseBorder" Color="#1A000000"/>
          <SolidColorBrush x:Key="PulseTextPrimary" Color="#1D1D1F"/>
          <SolidColorBrush x:Key="PulseTextSecondary" Color="#86868B"/>
          <SolidColorBrush x:Key="PulseTextTertiary" Color="#AEAEB2"/>
          <SolidColorBrush x:Key="PulseAccent" Color="#007AFF"/>
          <SolidColorBrush x:Key="PulseAccentSoft" Color="#1F007AFF"/>
          <SolidColorBrush x:Key="PulseHover" Color="#08000000"/>
          <SolidColorBrush x:Key="PulseRowHover" Color="#0A000000"/>
          <SolidColorBrush x:Key="PulseDestructive" Color="#FF3B30"/>
          <SolidColorBrush x:Key="PulseSuccess" Color="#34C759"/>
          <SolidColorBrush x:Key="PulseFlagged" Color="#FF9500"/>
          <SolidColorBrush x:Key="PulseOverlay" Color="#52000000"/>
          <!-- ListViewItem selection = accent-soft (matches web app) -->
          <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#1F007AFF"/>
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#29007AFF"/>
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#29007AFF"/>
          <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0A000000"/>
          <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#0F000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PulseBgSidebar" Color="#1C1C1E"/>
          <SolidColorBrush x:Key="PulseBgMailList" Color="#141416"/>
          <SolidColorBrush x:Key="PulseBgContent" Color="#141416"/>
          <SolidColorBrush x:Key="PulseBgToolbar" Color="#CC1C1C1E"/>
          <SolidColorBrush x:Key="PulseBgElevated" Color="#232326"/>
          <SolidColorBrush x:Key="PulseBorder" Color="#1FFFFFFF"/>
          <SolidColorBrush x:Key="PulseTextPrimary" Color="#F5F5F7"/>
          <SolidColorBrush x:Key="PulseTextSecondary" Color="#98989D"/>
          <SolidColorBrush x:Key="PulseTextTertiary" Color="#6E6E73"/>
          <SolidColorBrush x:Key="PulseAccent" Color="#0A84FF"/>
          <SolidColorBrush x:Key="PulseAccentSoft" Color="#330A84FF"/>
          <SolidColorBrush x:Key="PulseHover" Color="#0DFFFFFF"/>
          <SolidColorBrush x:Key="PulseRowHover" Color="#0FFFFFFF"/>
          <SolidColorBrush x:Key="PulseDestructive" Color="#FF453A"/>
          <SolidColorBrush x:Key="PulseSuccess" Color="#30D158"/>
          <SolidColorBrush x:Key="PulseFlagged" Color="#FF9F0A"/>
          <SolidColorBrush x:Key="PulseOverlay" Color="#8C000000"/>
          <!-- ListViewItem selection = accent-soft (matches web app) -->
          <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#330A84FF"/>
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#3D0A84FF"/>
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#3D0A84FF"/>
          <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0DFFFFFF"/>
          <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#14FFFFFF"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="PulseBgSidebar" Color="#F4F6FB"/>
          <SolidColorBrush x:Key="PulseBgMailList" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="PulseBgContent" Color="#F7F8FC"/>
          <SolidColorBrush x:Key="PulseBgToolbar" Color="#CCFFFFFF"/>
          <SolidColorBrush x:Key="PulseBgElevated" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="PulseBorder" Color="#1A000000"/>
          <SolidColorBrush x:Key="PulseTextPrimary" Color="#1D1D1F"/>
          <SolidColorBrush x:Key="PulseTextSecondary" Color="#86868B"/>
          <SolidColorBrush x:Key="PulseTextTertiary" Color="#AEAEB2"/>
          <SolidColorBrush x:Key="PulseAccent" Color="#007AFF"/>
          <SolidColorBrush x:Key="PulseAccentSoft" Color="#1F007AFF"/>
          <SolidColorBrush x:Key="PulseHover" Color="#08000000"/>
          <SolidColorBrush x:Key="PulseRowHover" Color="#0A000000"/>
          <SolidColorBrush x:Key="PulseDestructive" Color="#FF3B30"/>
          <SolidColorBrush x:Key="PulseSuccess" Color="#34C759"/>
          <SolidColorBrush x:Key="PulseFlagged" Color="#FF9500"/>
          <SolidColorBrush x:Key="PulseOverlay" Color="#52000000"/>
          <!-- ListViewItem selection = accent-soft (matches web app) -->
          <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#1F007AFF"/>
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#29007AFF"/>
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#29007AFF"/>
          <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0A000000"/>
          <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#0F000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <Style x:Key="PulseToolbarButton" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Foreground" Value="{ThemeResource PulseTextSecondary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>

      <Style x:Key="PulseSidebarButton" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,7"/>
        <Setter Property="Foreground" Value="{ThemeResource PulseTextPrimary}"/>
      </Style>

      <Style x:Key="PulseMailRow" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
      </Style>

      <x:Double x:Key="SidebarWidth">220</x:Double>
      <x:Double x:Key="ListWidth">340</x:Double>

      <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
      <converters:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
      <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
      <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
      <converters:StringToColorBrushConverter x:Key="StringToColorBrushConverter"/>
      <converters:ThreadCountVisibilityConverter x:Key="ThreadCountVisibilityConverter"/>
      <converters:UnreadDotVisibilityConverter x:Key="UnreadDotVisibilityConverter"/>
      <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
