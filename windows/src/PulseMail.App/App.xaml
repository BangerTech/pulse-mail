<Application
    x:Class="PulseMail.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PulseMail.App.Converters">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <SolidColorBrush x:Key="PulseAccent" Color="#0A84FF"/>
      <SolidColorBrush x:Key="PulseSidebarBg" Color="#F2F2F7"/>
      <SolidColorBrush x:Key="PulseSidebarBgDark" Color="#1C1C1E"/>
      <x:Double x:Key="SidebarWidth">220</x:Double>
      <x:Double x:Key="ListWidth">340</x:Double>

      <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
      <converters:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
      <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
      <converters:StringToColorBrushConverter x:Key="StringToColorBrushConverter"/>
      <converters:ThreadCountVisibilityConverter x:Key="ThreadCountVisibilityConverter"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
