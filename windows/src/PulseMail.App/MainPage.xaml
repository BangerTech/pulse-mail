<Page
    x:Class="PulseMail.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PulseMail.App.ViewModels"
    xmlns:controls="using:PulseMail.App.Controls"
    Background="{ThemeResource PulseBgContent}">

  <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown" Background="{ThemeResource PulseBgContent}">
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Toolbar — matches .toolbar -->
    <Border Grid.Row="0" Background="{ThemeResource PulseBgToolbar}"
            BorderBrush="{ThemeResource PulseBorder}" BorderThickness="0,0,0,1" Padding="8,0,12,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Style="{StaticResource PulseToolbarButton}" Command="{x:Bind ViewModel.ToggleSidebarCommand}" ToolTipService.ToolTip="Seitenleiste ([)">
            <FontIcon Glyph="&#xE700;" FontSize="14" Foreground="{ThemeResource PulseTextSecondary}"/>
          </Button>
          <Button Command="{x:Bind ViewModel.NewMailCommand}" Style="{StaticResource AccentButtonStyle}"
                  Height="32" Padding="12,0" CornerRadius="8" FontSize="13" FontWeight="SemiBold"
                  ToolTipService.ToolTip="Neue E-Mail (N)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE70F;" FontSize="13"/>
              <TextBlock Text="Neue E-Mail" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2" VerticalAlignment="Center">
          <Button Style="{StaticResource PulseToolbarButton}" Command="{x:Bind ViewModel.ArchiveSelectedCommand}" ToolTipService.ToolTip="Archivieren (E)">
            <FontIcon Glyph="&#xE7B8;" FontSize="14" Foreground="{ThemeResource PulseTextSecondary}"/>
          </Button>
          <Button Style="{StaticResource PulseToolbarButton}" Command="{x:Bind ViewModel.DeleteSelectedCommand}" ToolTipService.ToolTip="Löschen (#)">
            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource PulseDestructive}"/>
          </Button>
          <Button Style="{StaticResource PulseToolbarButton}" Command="{x:Bind ViewModel.ReplyCommand}" ToolTipService.ToolTip="Antworten (R)">
            <FontIcon Glyph="&#xE97A;" FontSize="14" Foreground="{ThemeResource PulseTextSecondary}"/>
          </Button>
          <Button Style="{StaticResource PulseToolbarButton}" Command="{x:Bind ViewModel.ReplyAllCommand}" ToolTipService.ToolTip="Allen antworten (A)">
            <FontIcon Glyph="&#xE8C2;" FontSize="14" Foreground="{ThemeResource PulseTextSecondary}"/>
          </Button>
          <Button Style="{StaticResource PulseToolbarButton}" Command="{x:Bind ViewModel.ForwardCommand}" ToolTipService.ToolTip="Weiterleiten (F)">
            <FontIcon Glyph="&#xE72A;" FontSize="14" Foreground="{ThemeResource PulseTextSecondary}"/>
          </Button>
          <Button Style="{StaticResource PulseToolbarButton}" Command="{x:Bind ViewModel.ToggleFlagCommand}" ToolTipService.ToolTip="Markieren (L)">
            <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource PulseFlagged}"/>
          </Button>
          <Button Style="{StaticResource PulseToolbarButton}" Command="{x:Bind ViewModel.ToggleSeenCommand}" ToolTipService.ToolTip="Gelesen (U)">
            <FontIcon Glyph="&#xE8BD;" FontSize="14" Foreground="{ThemeResource PulseTextSecondary}"/>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <AutoSuggestBox Width="200" PlaceholderText="Suchen (/)" FontSize="13"
                          Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                          QuerySubmitted="Search_QuerySubmitted"
                          x:Name="SearchBox"/>
          <Button Style="{StaticResource PulseToolbarButton}" Command="{x:Bind ViewModel.OpenSettingsCommand}" ToolTipService.ToolTip="Einstellungen (,)">
            <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource PulseTextSecondary}"/>
          </Button>
          <Button Style="{StaticResource PulseToolbarButton}" Command="{x:Bind ViewModel.CycleThemeCommand}" ToolTipService.ToolTip="Theme (T)">
            <FontIcon Glyph="&#xE706;" FontSize="14" Foreground="{ThemeResource PulseTextSecondary}"/>
          </Button>
          <Button Style="{StaticResource PulseToolbarButton}" Command="{x:Bind ViewModel.OpenPaletteCommand}" ToolTipService.ToolTip="Befehle (Ctrl+K)">
            <FontIcon Glyph="&#xE773;" FontSize="14" Foreground="{ThemeResource PulseTextSecondary}"/>
          </Button>
          <Button Style="{StaticResource PulseToolbarButton}" Command="{x:Bind ViewModel.RefreshMessagesCommand}" ToolTipService.ToolTip="Aktualisieren (.)">
            <FontIcon Glyph="&#xE72C;" FontSize="14" Foreground="{ThemeResource PulseTextSecondary}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" x:Name="MainLayout" Background="{ThemeResource PulseBgContent}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarCol" Width="220"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition x:Name="ListCol" Width="340"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="{ThemeResource PulseBgSidebar}" Padding="10,10,10,8"
              BorderBrush="{ThemeResource PulseBorder}" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Spacing="2">
            <Button Style="{StaticResource PulseSidebarButton}" Click="UnifiedInbox_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE715;" FontSize="14" Foreground="{ThemeResource PulseAccent}" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="Alle Eingänge" FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource PulseTextPrimary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.TotalUnread, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource PulseTextSecondary}" Margin="8,0,0,0"/>
              </Grid>
            </Button>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AccountNavItem">
                  <StackPanel Margin="0,8,0,0">
                    <Button Style="{StaticResource PulseSidebarButton}" Tag="{x:Bind}" Click="AccountInbox_Click">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" Margin="2,0,10,0"
                                 Fill="{x:Bind Account.Color, Converter={StaticResource StringToColorBrushConverter}}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Account.Name}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PulseTextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind Unread, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource PulseTextSecondary}" Margin="8,0,0,0"/>
                      </Grid>
                    </Button>
                    <ItemsControl ItemsSource="{x:Bind Folders}" Margin="6,0,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FolderNavItem">
                          <Button Style="{StaticResource PulseSidebarButton}" Padding="22,4,8,4"
                                  Tag="{x:Bind}" Click="Folder_Click">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="Normal"
                                         Foreground="{ThemeResource PulseTextPrimary}" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Grid.Column="1" Text="{x:Bind Unread, Mode=OneWay}" FontSize="11"
                                         Foreground="{ThemeResource PulseTextTertiary}"/>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="1" Background="Transparent" PointerPressed="SidebarSplitter_Pressed"
              PointerMoved="Splitter_Moved" PointerReleased="Splitter_Released"/>

      <!-- Mail list -->
      <Border Grid.Column="2" Background="{ThemeResource PulseBgMailList}"
              BorderBrush="{ThemeResource PulseBorder}" BorderThickness="0,0,1,0">
        <ListView x:Name="MailList"
                  ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedMessage, Mode=TwoWay}"
                  SelectionChanged="MailList_SelectionChanged"
                  DoubleTapped="MailList_DoubleTapped"
                  IsItemClickEnabled="True"
                  ItemClick="MailList_ItemClick"
                  Background="{ThemeResource PulseBgMailList}"
                  ItemContainerStyle="{StaticResource PulseMailRow}"
                  SelectionMode="Single">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:MailListItem">
              <Grid Padding="6,11,14,11" ColumnSpacing="10"
                    Background="{x:Bind RowBackground, Mode=OneWay}"
                    BorderBrush="{ThemeResource PulseBorder}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="36"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,10,0,0"
                         Fill="{ThemeResource PulseAccent}"
                         Visibility="{x:Bind IsUnread, Converter={StaticResource UnreadDotVisibilityConverter}}"/>

                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top" Margin="0,2,0,0"
                        Background="{x:Bind AvatarColor, Converter={StaticResource StringToColorBrushConverter}}">
                  <Grid>
                    <TextBlock Text="{x:Bind AvatarInitial}" FontSize="13" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{x:Bind HasAvatarImage, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <Ellipse Width="36" Height="36"
                             Visibility="{x:Bind HasAvatarImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                      <Ellipse.Fill>
                        <ImageBrush ImageSource="{x:Bind AvatarImage, Mode=OneWay}" Stretch="UniformToFill"/>
                      </Ellipse.Fill>
                    </Ellipse>
                  </Grid>
                </Border>

                <StackPanel Grid.Column="2" Spacing="2">
                  <TextBlock Text="{x:Bind PrimaryLabel}" FontSize="13" TextTrimming="CharacterEllipsis"
                             Foreground="{x:Bind PrimaryTextBrush, Mode=OneWay}"
                             FontWeight="{x:Bind IsUnread, Converter={StaticResource BoolToFontWeightConverter}}"/>
                  <TextBlock Text="{x:Bind SubjectText}" FontSize="13" TextTrimming="CharacterEllipsis"
                             Foreground="{x:Bind PrimaryTextBrush, Mode=OneWay}"
                             FontWeight="{x:Bind IsUnread, Converter={StaticResource BoolToFontWeightConverter}}"/>
                  <TextBlock Text="{x:Bind SnippetText}" FontSize="12"
                             Foreground="{x:Bind SecondaryTextBrush, Mode=OneWay}"
                             TextTrimming="CharacterEllipsis" MaxLines="1"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Spacing="4" HorizontalAlignment="Right">
                  <TextBlock Text="{x:Bind DisplayDate}" FontSize="11"
                             Foreground="{x:Bind TertiaryTextBrush, Mode=OneWay}"/>
                  <Border Background="{x:Bind BadgeBackground, Mode=OneWay}" CornerRadius="8" Padding="6,1"
                          HorizontalAlignment="Right"
                          Visibility="{x:Bind ThreadCount, Converter={StaticResource ThreadCountVisibilityConverter}}">
                    <TextBlock Text="{x:Bind ThreadCount}" Foreground="{x:Bind BadgeForeground, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                  </Border>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Border>

      <Border Grid.Column="3" Background="Transparent" PointerPressed="ListSplitter_Pressed"
              PointerMoved="Splitter_Moved" PointerReleased="Splitter_Released"/>

      <!-- Reading pane -->
      <Grid Grid.Column="4" x:Name="ReadingPane" Background="{ThemeResource PulseBgContent}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      Visibility="{x:Bind ViewModel.ReadingMessage, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
          <StackPanel Padding="20,12,20,8" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Style="{StaticResource PulseToolbarButton}" Command="{x:Bind ViewModel.ReplyCommand}" ToolTipService.ToolTip="Antworten (R)">
                <FontIcon Glyph="&#xE97A;" FontSize="14" Foreground="{ThemeResource PulseTextSecondary}"/>
              </Button>
              <Button Style="{StaticResource PulseToolbarButton}" Command="{x:Bind ViewModel.ReplyAllCommand}" ToolTipService.ToolTip="Allen antworten (A)">
                <FontIcon Glyph="&#xE8C2;" FontSize="14" Foreground="{ThemeResource PulseTextSecondary}"/>
              </Button>
              <Button Style="{StaticResource PulseToolbarButton}" Command="{x:Bind ViewModel.ForwardCommand}" ToolTipService.ToolTip="Weiterleiten (F)">
                <FontIcon Glyph="&#xE72A;" FontSize="14" Foreground="{ThemeResource PulseTextSecondary}"/>
              </Button>
              <Border Width="1" Background="{ThemeResource PulseBorder}" Margin="6,4"/>
              <Button Style="{StaticResource PulseToolbarButton}" Command="{x:Bind ViewModel.ArchiveSelectedCommand}" ToolTipService.ToolTip="Archivieren (E)">
                <FontIcon Glyph="&#xE7B8;" FontSize="14" Foreground="{ThemeResource PulseTextSecondary}"/>
              </Button>
              <Button Style="{StaticResource PulseToolbarButton}" Command="{x:Bind ViewModel.ToggleFlagCommand}" ToolTipService.ToolTip="Markieren (L)">
                <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource PulseFlagged}"/>
              </Button>
              <Button Style="{StaticResource PulseToolbarButton}" Command="{x:Bind ViewModel.DeleteSelectedCommand}" ToolTipService.ToolTip="Löschen">
                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource PulseDestructive}"/>
              </Button>
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.ReadingSubject, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{ThemeResource PulseTextPrimary}" TextWrapping="Wrap"/>

            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Width="40" Height="40" CornerRadius="20"
                      Background="{x:Bind ViewModel.ReadingAvatarColor, Mode=OneWay, Converter={StaticResource StringToColorBrushConverter}}">
                <Grid>
                  <TextBlock Text="{x:Bind ViewModel.ReadingAvatarInitial, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{x:Bind ViewModel.ReadingHasAvatar, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                  <Ellipse Width="40" Height="40"
                           Visibility="{x:Bind ViewModel.ReadingHasAvatar, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Ellipse.Fill>
                      <ImageBrush ImageSource="{x:Bind ViewModel.ReadingAvatarImage, Mode=OneWay}" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                  </Ellipse>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <Grid>
                  <TextBlock Text="{x:Bind ViewModel.ReadingFromName, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                             Foreground="{ThemeResource PulseTextPrimary}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{x:Bind ViewModel.ReadingDateText, Mode=OneWay}" FontSize="12"
                             Foreground="{ThemeResource PulseTextTertiary}" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.ReadingFromEmail, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource PulseTextSecondary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind ViewModel.ReadingToLine, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource PulseTextTertiary}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>

            <Border Background="{ThemeResource PulseBgElevated}" CornerRadius="10" Padding="10,8"
                    BorderBrush="{ThemeResource PulseBorder}" BorderThickness="1"
                    Visibility="{x:Bind ViewModel.HasConversation, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
              <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.ReadingThreadLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource PulseTextSecondary}"/>
                <ItemsControl ItemsSource="{x:Bind ViewModel.ThreadMessages, Mode=OneWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Click="ThreadMessage_Click" Tag="{Binding}" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" Padding="8,6" Margin="0,2,0,0"
                              Background="Transparent" BorderThickness="0" CornerRadius="6">
                        <Grid ColumnSpacing="8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource PulseTextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subject}" FontSize="12"
                                       Foreground="{ThemeResource PulseTextSecondary}" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding DateLabel}" FontSize="11"
                                     Foreground="{ThemeResource PulseTextTertiary}" VerticalAlignment="Center"/>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <ItemsControl x:Name="AttachmentList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Button x:Name="LoadRemoteBtn" Content="Externe Bilder laden" Click="LoadRemote_Click"
                    Visibility="Collapsed" CornerRadius="8" HorizontalAlignment="Left"/>
          </StackPanel>
        </ScrollViewer>

        <controls:MailWebView x:Name="MailBodyView" Grid.Row="1" Margin="8,0,8,8"/>

        <TextBlock Grid.Row="1" Text="Keine Nachricht ausgewählt"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource PulseTextTertiary}" FontSize="14"
                   Visibility="{x:Bind ViewModel.ReadingMessage, Mode=OneWay, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
      </Grid>
    </Grid>

    <controls:AccountSetupOverlay x:Name="SetupOverlay" Grid.RowSpan="2"
                                  Visibility="{x:Bind ViewModel.NeedsSetup, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
    <controls:SettingsOverlay x:Name="SettingsOverlay" Grid.RowSpan="2"
                              Visibility="{x:Bind ViewModel.SettingsOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
    <controls:ComposeOverlay x:Name="ComposeOverlay" Grid.RowSpan="2"
                             Visibility="{x:Bind ViewModel.ComposeOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
    <controls:CommandPaletteOverlay x:Name="PaletteOverlay" Grid.RowSpan="2"
                                    Visibility="{x:Bind ViewModel.PaletteOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
  </Grid>
</Page>
