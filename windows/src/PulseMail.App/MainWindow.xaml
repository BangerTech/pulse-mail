<Window
    x:Class="PulseMail.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PulseMail.App.ViewModels"
    xmlns:controls="using:PulseMail.App.Controls"
    Title="Pulse Mail">

  <!--
    WinUI Window is not a FrameworkElement; x:Bind at Window scope fails to compile.
    Use {Binding} against RootGrid.DataContext (= ViewModel). DataTemplates may still x:Bind.
  -->
  <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="8,6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Command="{Binding ToggleSidebarCommand}" ToolTipService.ToolTip="Seitenleiste ([)">
            <FontIcon Glyph="&#xE700;" FontSize="14"/>
          </Button>
          <Button Command="{Binding NewMailCommand}" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Neue E-Mail (N)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE70F;" FontSize="14"/>
              <TextBlock Text="Neue E-Mail"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
          <Button Command="{Binding ArchiveSelectedCommand}" ToolTipService.ToolTip="Archivieren (E)">
            <FontIcon Glyph="&#xE7B8;" FontSize="14"/>
          </Button>
          <Button Command="{Binding DeleteSelectedCommand}" ToolTipService.ToolTip="Löschen (#)">
            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
          </Button>
          <Button Command="{Binding ReplyCommand}" ToolTipService.ToolTip="Antworten (R)">
            <FontIcon Glyph="&#xE97A;" FontSize="14"/>
          </Button>
          <Button Command="{Binding ReplyAllCommand}" ToolTipService.ToolTip="Allen antworten (A)">
            <FontIcon Glyph="&#xE8C2;" FontSize="14"/>
          </Button>
          <Button Command="{Binding ForwardCommand}" ToolTipService.ToolTip="Weiterleiten (F)">
            <FontIcon Glyph="&#xE72A;" FontSize="14"/>
          </Button>
          <Button Command="{Binding ToggleFlagCommand}" ToolTipService.ToolTip="Markieren (L)">
            <FontIcon Glyph="&#xE735;" FontSize="14"/>
          </Button>
          <Button Command="{Binding ToggleSeenCommand}" ToolTipService.ToolTip="Gelesen (U)">
            <FontIcon Glyph="&#xE8BD;" FontSize="14"/>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <AutoSuggestBox Width="200" PlaceholderText="Suchen (/)"
                          Text="{Binding SearchText, Mode=TwoWay}"
                          QuerySubmitted="Search_QuerySubmitted"
                          x:Name="SearchBox"/>
          <Button Command="{Binding OpenSettingsCommand}" ToolTipService.ToolTip="Einstellungen (,)">
            <FontIcon Glyph="&#xE713;" FontSize="14"/>
          </Button>
          <Button Command="{Binding CycleThemeCommand}" ToolTipService.ToolTip="Theme (T)">
            <FontIcon Glyph="&#xE706;" FontSize="14"/>
          </Button>
          <Button Command="{Binding OpenPaletteCommand}" ToolTipService.ToolTip="Befehle (?)">
            <FontIcon Glyph="&#xE773;" FontSize="14"/>
          </Button>
          <Button Command="{Binding RefreshMessagesCommand}" ToolTipService.ToolTip="Aktualisieren (.)">
            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" x:Name="MainLayout">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarCol" Width="220"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition x:Name="ListCol" Width="340"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="8">
        <ScrollViewer>
          <StackPanel Spacing="4">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Click="UnifiedInbox_Click">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE715;" FontSize="14"/>
                <TextBlock Text="Alle Eingänge" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TotalUnread}" Opacity="0.6"/>
              </StackPanel>
            </Button>

            <ItemsControl ItemsSource="{Binding Accounts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AccountNavItem">
                  <StackPanel Margin="0,8,0,0">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Tag="{x:Bind}" Click="AccountInbox_Click">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                 Fill="{x:Bind Account.Color, Converter={StaticResource StringToColorBrushConverter}}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Account.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind Unread, Mode=OneWay}" Opacity="0.6" Margin="8,0,0,0"/>
                      </Grid>
                    </Button>
                    <ItemsControl ItemsSource="{x:Bind Folders}" Margin="16,0,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FolderNavItem">
                          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                  Tag="{x:Bind}" Click="Folder_Click" Padding="8,4">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Grid.Column="1" Text="{x:Bind Unread, Mode=OneWay}" Opacity="0.5" FontSize="12"/>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="1" Background="Transparent" PointerPressed="SidebarSplitter_Pressed" PointerMoved="Splitter_Moved" PointerReleased="Splitter_Released"/>

      <Border Grid.Column="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
        <ListView x:Name="MailList"
                  ItemsSource="{Binding Messages}"
                  SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                  SelectionChanged="MailList_SelectionChanged"
                  DoubleTapped="MailList_DoubleTapped"
                  IsItemClickEnabled="True"
                  ItemClick="MailList_ItemClick">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:MailListItem">
              <Grid Padding="12,10" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="36"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="16" Background="#0A84FF" VerticalAlignment="Top">
                  <TextBlock Text="{x:Bind AvatarInitial}" FontSize="14" FontWeight="SemiBold"
                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                             MaxLines="1"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="{x:Bind PrimaryLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{x:Bind Message.Subject}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{x:Bind Message.Snippet}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                  <TextBlock Text="{x:Bind DisplayDate}" FontSize="11" Opacity="0.6"/>
                  <Border Background="#0A84FF" CornerRadius="8" Padding="6,1"
                          HorizontalAlignment="Right"
                          Visibility="{x:Bind ThreadCount, Converter={StaticResource ThreadCountVisibilityConverter}}">
                    <TextBlock Text="{x:Bind ThreadCount}" Foreground="White" FontSize="11"/>
                  </Border>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Border>

      <Border Grid.Column="3" Background="Transparent" PointerPressed="ListSplitter_Pressed" PointerMoved="Splitter_Moved" PointerReleased="Splitter_Released"/>

      <Grid Grid.Column="4" x:Name="ReadingPane">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="20,16,20,8" Spacing="4"
                    Visibility="{Binding ReadingMessage, Converter={StaticResource NullToVisibilityConverter}}">
          <TextBlock Text="{Binding ReadingSubject}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ReadingFromLine}" Opacity="0.7"/>
          <TextBlock Text="{Binding ReadingDateText}" FontSize="12" Opacity="0.5"/>

          <ItemsControl ItemsSource="{Binding ThreadMessages}" Margin="0,8,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Date}" Click="ThreadMessage_Click" Tag="{Binding}" Padding="8,4" FontSize="11"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <controls:MailWebView x:Name="MailBodyView" Grid.Row="1" Margin="8"/>

        <StackPanel Grid.Row="2" Margin="16,0,16,12" Spacing="8">
          <Button x:Name="LoadRemoteBtn" Content="Externe Bilder laden" Click="LoadRemote_Click" Visibility="Collapsed"/>
          <ItemsControl x:Name="AttachmentList"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Keine Nachricht ausgewählt" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.4" FontSize="16"
                   Visibility="{Binding ReadingMessage, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
      </Grid>
    </Grid>

    <controls:AccountSetupOverlay x:Name="SetupOverlay" Grid.RowSpan="2"
                                  Visibility="{Binding NeedsSetup, Converter={StaticResource BoolToVisibilityConverter}}"/>
    <controls:SettingsOverlay x:Name="SettingsOverlay" Grid.RowSpan="2"
                              Visibility="{Binding SettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
    <controls:ComposeOverlay x:Name="ComposeOverlay" Grid.RowSpan="2"
                             Visibility="{Binding ComposeOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
    <controls:CommandPaletteOverlay x:Name="PaletteOverlay" Grid.RowSpan="2"
                                    Visibility="{Binding PaletteOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
  </Grid>
</Window>
