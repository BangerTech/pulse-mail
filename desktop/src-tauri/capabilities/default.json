{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-local",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-overlay-icon",
    "core:window:allow-request-user-attention",
    "notification:default",
    "allow-get-server-url",
    "allow-save-server-url",
    "allow-set-dock-badge",
    "allow-clear-dock-badge",
    "allow-save-attachment"
  ]
}
